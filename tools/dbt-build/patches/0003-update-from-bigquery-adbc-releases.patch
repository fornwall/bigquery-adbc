+/// Replaces this binary with bigquery-adbc's latest release by running that release's install.sh,
+/// as dbt Labs' distribution runs its own installer. The script takes the same `--prefix` or `--to`
+/// location, and also reads BIGQUERY_ADBC_RELEASES_URL, which overrides where the releases are.
+fn update_from_bigquery_adbc() -> FsResult<()> {
+    #[allow(clippy::disallowed_methods)]
+    let releases = std::env::var("BIGQUERY_ADBC_RELEASES_URL")
+        .unwrap_or_else(|_| String::from("https://github.com/fornwall/bigquery-adbc/releases"));
+    if cfg!(windows) {
+        return Err(fs_err!(
+            ErrorCode::NotSupported,
+            "`system update` needs install.sh, which does not support Windows. Download the latest \
+             release from {releases}"
+        ));
+    }
+    let exe = std::env::current_exe()
+        .map(|path| dbt_common::stdfs::canonicalize(&path).unwrap_or(path))
+        .map_err(|e| fs_err!(ErrorCode::IoError, "Cannot find this executable: {e}"))?;
+    let Some(bin_dir) = exe.parent() else {
+        return Err(fs_err!(
+            ErrorCode::IoError,
+            "{} has no parent directory",
+            exe.display()
+        ));
+    };
+    let location = dbt_dist::packages::InstallLocation::for_bin_dir(bin_dir);
+    let (option, path) = location.script_option();
+    // Fetching the script first means a failed download fails the update, which piping curl into
+    // sh would hide.
+    let status = std::process::Command::new("sh")
+        .args([
+            "-c",
+            r#"script=$(curl -fsSL "$1/latest/download/install.sh") || exit 1
+exec sh -c "$script" install.sh --update "--$2" "$3""#,
+            "sh",
+            releases.as_str(),
+            option,
+        ])
+        .arg(path)
+        .status()
+        .map_err(|e| fs_err!(ErrorCode::IoError, "Cannot run sh: {e}"))?;
+    if status.success() {
+        Ok(())
+    } else {
+        Err(fs_err!(
+            ErrorCode::IoError,
+            "The install script from {releases} failed ({status})"
+        ))
+    }
+}
