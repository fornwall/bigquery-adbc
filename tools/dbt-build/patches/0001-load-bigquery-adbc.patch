+    /// Loads the library a non-release bigquery-adbc build installs in `lib/bigquery-adbc/`, beside
+    /// the executable or one level up, as `<prefix>/bin/` and `<prefix>/lib/` place them.
+    fn try_load_installed_bigquery_adbc(
+        backend: Backend,
+        adbc_version: AdbcVersion,
+    ) -> Result<ManagedAdbcDriver> {
+        const LIB_HEIGHT_MAX: usize = 1;
+        let subpath: PathBuf = ["lib", "bigquery-adbc"].iter().collect();
+        let name = backend.adbc_library_name().unwrap();
+        let Some(dir) = find_upward_dir_from_exe(&subpath, LIB_HEIGHT_MAX) else {
+            return Err(Error::with_message_and_status(
+                "This dbt build loads its BigQuery driver from lib/bigquery-adbc/ beside the \
+                 binary, which is missing. Set BIGQUERY_ADBC_USE_DBT_DRIVER=1 to use dbt's driver.",
+                Status::NotFound,
+            ));
+        };
+        let path = dir.join(libloading::library_filename(name));
+        tracing::debug!("{backend} driver resolved: installed {}", path.display());
+        ManagedAdbcDriver::load_dynamic_from_filename(
+            backend,
+            &path,
+            backend.adbc_driver_entrypoint(),
+            adbc_version,
+        )
+    }
