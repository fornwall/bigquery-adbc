+/// Whether `BIGQUERY_ADBC_USE_DBT_DRIVER` asks for dbt's own BigQuery driver, resolved exactly as
+/// stock dbt resolves it. Read once per process: dbt caches loaded drivers by backend alone.
+pub fn use_dbt_bigquery_driver() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| env_var::env_var_bool_or_warn("BIGQUERY_ADBC_USE_DBT_DRIVER"))
+}
