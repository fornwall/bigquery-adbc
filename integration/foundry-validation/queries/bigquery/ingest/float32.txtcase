// part: metadata

[tags]
sql-type-name = "FLOAT64"
field-type-name = "FLOAT64"
caveats = [
    "BigQuery widens Arrow float32 values to FLOAT64.",
]

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "idx",
            "format": "l",
            "flags": ["nullable"]
        },
        {
            "name": "value",
            "format": "g",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"idx": 0, "value": 0.0}
{"idx": 1, "value": 3.140000104904175}
{"idx": 2, "value": -3.140000104904175}
{"idx": 3, "value": 16777216}
{"idx": 4, "value": -16777216}
{"idx": 5, "value": 3.4028234663852886e+38}
{"idx": 6, "value": -3.4028234663852886e+38}
{"idx": 7, "value": null}

