// part: metadata

[setup]
drop = "test_bigdecimal"

[tags]
show-arrow-type-parameters = true
sql-type-name = "BIGNUMERIC"
field-type-name = "BIGNUMERIC"

// part: setup_query

CREATE TABLE test_bigdecimal (
    idx INT64,
    res BIGNUMERIC(60, 30)
);

INSERT INTO test_bigdecimal (idx, res) VALUES
    (1, BIGNUMERIC '123.45'),
    (2, BIGNUMERIC '0.00'),
    (3, BIGNUMERIC '-999.99'),
    (4, BIGNUMERIC '999999999999999999999999999999.999999999999999999999999999999'),
    (5, NULL);

// part: query

SELECT res FROM test_bigdecimal ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "d:76,38,256",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": "123.45"}
{"res": "0.00"}
{"res": "-999.99"}
{"res": "999999999999999999999999999999.999999999999999999999999999999"}
{"res": null}
