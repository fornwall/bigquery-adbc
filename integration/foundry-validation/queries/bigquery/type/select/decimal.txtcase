// part: metadata

[setup]
drop = "test_decimal"

[tags]
sql-type-name = "NUMERIC"
field-type-name = "NUMERIC"

// part: setup_query

CREATE TABLE test_decimal (
    idx INT64,
    res NUMERIC(10, 2)
);

INSERT INTO test_decimal (idx, res) VALUES
    (1, NUMERIC '123.45'),
    (2, NUMERIC '0.00'),
    (3, NUMERIC '-999.99'),
    (4, NUMERIC '9999999.99'),
    (5, NULL);

// part: query

SELECT res FROM test_decimal ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "d:38,9",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": "123.45"}
{"res": "0.00"}
{"res": "-999.99"}
{"res": "9999999.99"}
{"res": null}
