// part: metadata

[setup]
drop = "test_range_timestamp"

[tags]
show-arrow-type-parameters = true
sql-type-name = "RANGE<TIMESTAMP>"
field-type-name = "RANGE<TIMESTAMP>"

// part: setup_query

CREATE TABLE test_range_timestamp (
    idx INT64,
    res RANGE<TIMESTAMP>
);

INSERT INTO test_range_timestamp (idx, res) VALUES
    (0, NULL),
    (1, RANGE<TIMESTAMP> '[UNBOUNDED, UNBOUNDED)'),
    (2, RANGE<TIMESTAMP> '[UNBOUNDED, 2020-12-31 09:01:23.456789)'),
    (3, RANGE<TIMESTAMP> '[2020-01-01 00:01:02.345678, UNBOUNDED)'),
    (4, RANGE<TIMESTAMP> '[2020-01-01 00:01:02.345678, 2020-12-31 09:01:23.456789)'),
    (5, RANGE<TIMESTAMP> '[0001-01-01 00:00:00.000000, 9999-12-31 23:59:59.999999)');

// part: query

SELECT res FROM test_range_timestamp ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "+s",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "start",
                    "format": "tsu:UTC",
                    "flags": ["nullable"]
                },
                {
                    "name": "end",
                    "format": "tsu:UTC",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: expected

{"res": null}
{"res": {"start": null, "end": null}}
{"res": {"start": null, "end": 1609405283456789}}
{"res": {"start": 1577836862345678, "end": null}}
{"res": {"start": 1577836862345678, "end": 1609405283456789}}
{"res": {"start": -62135596800000000, "end": 253402300799999999}}
