// part: metadata

[setup]
drop = "test_time"

[tags]
sql-type-name = "TIME"
field-type-name = "TIME"

// part: setup_query

CREATE TABLE test_time (
    idx INT64,
    res TIME
);

INSERT INTO test_time (idx, res) VALUES
    (1, TIME '13:45:31.123456'),
    (2, TIME '00:00:00'),
    (3, TIME '23:59:59.999999'),
    (4, TIME '12:30:45.500'),
    (5, NULL);

// part: query

SELECT res FROM test_time ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "ttu",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": 49531123456}
{"res": 0}
{"res": 86399999999}
{"res": 45045500000}
{"res": null}
