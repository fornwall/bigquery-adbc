// part: metadata

ignore-lints = ["must-test-null-values"]

[setup]
drop = "test_json"

[tags]
sql-type-name = "JSON"
field-type-name = ["JSON", "ARRAY<JSON>", "STRUCT<`a` JSON, `b` ARRAY<JSON>>"]

// part: setup_query

CREATE TABLE test_json (
    idx INT64,
    res JSON,
    res2 ARRAY<JSON>,
    res3 STRUCT<a JSON, b ARRAY<JSON>>
);

INSERT INTO test_json (idx, res, res2, res3) VALUES
    (0, JSON '{}', [JSON '{}'], (JSON '{}', [JSON '{}'])),
    (1, JSON '{"a": 1, "b": 2}', [JSON '{"a": 1, "b": 2}'], (JSON '{"a": 1, "b": 2}', [JSON '{"a": 1, "b": 2}'])),
    (2, JSON '{"a": [1, 2, 3], "b": {"c": "d"}}', [JSON '{"a": [1, 2, 3], "b": {"c": "d"}}'], (JSON '{"a": [1, 2, 3], "b": {"c": "d"}}', [JSON '{"a": [1, 2, 3], "b": {"c": "d"}}'])),
    (3, JSON '{"x": null, "y": true, "z": false}', [JSON '{"x": null, "y": true, "z": false}'], (JSON '{"x": null, "y": true, "z": false}', [JSON '{"x": null, "y": true, "z": false}'])),
    (4, JSON '{"nested": {"array": [1, 2, 3]}}', [JSON '{"nested": {"array": [1, 2, 3]}}'], (JSON '{"nested": {"array": [1, 2, 3]}}', [JSON '{"nested": {"array": [1, 2, 3]}}'])),
    (5, JSON '[1, 2, {"key": "value"}]', [JSON '[1, 2, {"key": "value"}]'], (JSON '[1, 2, {"key": "value"}]', [JSON '[1, 2, {"key": "value"}]'])),
    (6, JSON 'null', [JSON 'null'], (JSON 'null', [JSON 'null'])),
    (7, JSON 'true', [JSON 'true'], (JSON 'true', [JSON 'true'])),
    (8, JSON 'false', [JSON 'false'], (JSON 'false', [JSON 'false'])),
    (9, JSON '"string value"', [JSON '"string value"'], (JSON '"string value"', [JSON '"string value"'])),
    (10, JSON '12345', [JSON '12345'], (JSON '12345', [JSON '12345'])),
    (11, NULL, NULL, NULL);

// part: query

SELECT res, res2, res3 FROM test_json ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "u",
            "flags": ["nullable"],
            "metadata": {
                "ARROW:extension:name": "arrow.json"
            }
        },
        {
            "name": "res2",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "u",
                    "flags": ["nullable"],
                    "metadata": {
                        "ARROW:extension:name": "arrow.json"
                    }
                }
            ]
        },
        {
            "name": "res3",
            "format": "+s",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "a",
                    "format": "u",
                    "flags": ["nullable"],
                    "metadata": {
                        "ARROW:extension:name": "arrow.json"
                    }
                },
                {
                    "name": "b",
                    "format": "+l",
                    "flags": ["nullable"],
                    "children": [
                        {
                            "name": "item",
                            "format": "u",
                            "flags": ["nullable"],
                            "metadata": {
                                "ARROW:extension:name": "arrow.json"
                            }
                        }
                    ]
                }
            ]
        }
    ]
}

// part: expected

{"res": "{}", "res2": ["{}"], "res3": {"a": "{}", "b": ["{}"]}}
{"res": "{\"a\":1,\"b\":2}", "res2": ["{\"a\":1,\"b\":2}"], "res3": {"a": "{\"a\":1,\"b\":2}", "b": ["{\"a\":1,\"b\":2}"]}}
{"res": "{\"a\":[1,2,3],\"b\":{\"c\":\"d\"}}", "res2": ["{\"a\":[1,2,3],\"b\":{\"c\":\"d\"}}"], "res3": {"a": "{\"a\":[1,2,3],\"b\":{\"c\":\"d\"}}", "b": ["{\"a\":[1,2,3],\"b\":{\"c\":\"d\"}}"]}}
{"res": "{\"x\":null,\"y\":true,\"z\":false}", "res2": ["{\"x\":null,\"y\":true,\"z\":false}"], "res3": {"a": "{\"x\":null,\"y\":true,\"z\":false}", "b": ["{\"x\":null,\"y\":true,\"z\":false}"]}}
{"res": "{\"nested\":{\"array\":[1,2,3]}}", "res2": ["{\"nested\":{\"array\":[1,2,3]}}"], "res3": {"a": "{\"nested\":{\"array\":[1,2,3]}}", "b": ["{\"nested\":{\"array\":[1,2,3]}}"]}}
{"res": "[1,2,{\"key\":\"value\"}]", "res2": ["[1,2,{\"key\":\"value\"}]"], "res3": {"a": "[1,2,{\"key\":\"value\"}]", "b": ["[1,2,{\"key\":\"value\"}]"]}}
{"res": "null", "res2": ["null"], "res3": {"a": "null", "b": ["null"]}}
{"res": "true", "res2": ["true"], "res3": {"a": "true", "b": ["true"]}}
{"res": "false", "res2": ["false"], "res3": {"a": "false", "b": ["false"]}}
{"res": "\"string value\"", "res2": ["\"string value\""], "res3": {"a": "\"string value\"", "b": ["\"string value\""]}}
{"res": "12345", "res2": ["12345"], "res3": {"a": "12345", "b": ["12345"]}}
{"res": null, "res2": [], "res3": null}
