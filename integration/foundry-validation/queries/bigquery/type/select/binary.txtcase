// part: metadata

[setup]
drop = "test_binary"

[tags]
sql-type-name = "BYTES"
field-type-name = "BYTES"

// part: setup_query

CREATE TABLE test_binary (
    idx INT64,
    res BYTES
);

INSERT INTO test_binary (idx, res) VALUES
    (1, b'\xe3\x81\x93\xe3\x82\x93\xe3\x81\xab\xe3\x81\xa1\xe3\x81\xaf\xe3\x80\x81\xe4\xb8\x96\xe7\x95\x8c\xef\xbc\x81'),
    (2, b'\x00'),
    (3, b'\xde\xad\xbe\xef'),
    (4, b''),
    (5, NULL);

// part: query

SELECT res FROM test_binary ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "z",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": "44GT44KT44Gr44Gh44Gv44CB5LiW55WM77yB"}
{"res": "AA=="}
{"res": "3q2+7w=="}
{"res": ""}
{"res": null}
