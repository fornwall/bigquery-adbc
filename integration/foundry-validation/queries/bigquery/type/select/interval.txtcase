// part: metadata

[setup]
drop = "test_interval"

[tags]
sql-type-name = "INTERVAL"
field-type-name = "INTERVAL"

// part: setup_query

CREATE TABLE test_interval (
    idx INT64,
    res INTERVAL
);

INSERT INTO test_interval (idx, res) VALUES
    (0, INTERVAL 1 YEAR),
    (1, INTERVAL 1 QUARTER),
    (2, INTERVAL 1 MONTH),
    (3, INTERVAL 1 DAY),
    (4, INTERVAL 1 HOUR),
    (5, INTERVAL 1 MINUTE),
    (6, INTERVAL 1 SECOND),
    (7, INTERVAL 1 MILLISECOND),
    (8, INTERVAL 1 MICROSECOND),
    (9, INTERVAL '1-2' YEAR TO MONTH),
    (10, INTERVAL '1 15' MONTH TO DAY),
    (11, INTERVAL '-10-1 5 -12:30:01' YEAR TO SECOND),
    (12, NULL);

// part: query

SELECT res FROM test_interval ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tin",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": "12M0d0ns"}
{"res": "3M0d0ns"}
{"res": "1M0d0ns"}
{"res": "0M1d0ns"}
{"res": "0M0d3600000000000ns"}
{"res": "0M0d60000000000ns"}
{"res": "0M0d1000000000ns"}
{"res": "0M0d1000000ns"}
{"res": "0M0d1000ns"}
{"res": "14M0d0ns"}
{"res": "1M15d0ns"}
{"res": "-121M5d-45001000000000ns"}
{"res": null}
