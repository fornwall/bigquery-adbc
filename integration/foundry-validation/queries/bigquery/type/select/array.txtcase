// part: metadata

ignore-lints = ["must-test-null-values"]

[setup]
drop = "test_array"

[tags]
field-type-name = [
    "ARRAY<BOOL>",
    "ARRAY<BOOL>",
    "ARRAY<INT64>",
    "ARRAY<INT64>",
    "ARRAY<STRING>",
    "ARRAY<STRING>",
]
sql-type-name = "ARRAY"
caveats = ["BigQuery normalizes NULL arrays to empty arrays in query results."]

// part: setup_query

CREATE TABLE test_array (
    idx INT64,
    res_bool ARRAY<BOOL>,
    res_bool_null ARRAY<BOOL>,
    res_int64 ARRAY<INT64>,
    res_int64_null ARRAY<INT64>,
    res_string ARRAY<STRING>,
    res_string_null ARRAY<STRING>
);

INSERT INTO test_array (
    idx,
    res_bool,
    res_bool_null,
    res_int64,
    res_int64_null,
    res_string,
    res_string_null
) VALUES (
    1,
    [TRUE, FALSE],
    CAST(NULL AS ARRAY<BOOL>),
    [1, 2, 3],
    CAST(NULL AS ARRAY<INT64>),
    ['', 'foobar'],
    CAST(NULL AS ARRAY<STRING>)
);

// part: query

SELECT
    res_bool,
    res_bool_null,
    res_int64,
    res_int64_null,
    res_string,
    res_string_null
FROM test_array
ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res_bool",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "b",
                    "flags": ["nullable"]
                }
            ]
        },
        {
            "name": "res_bool_null",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "b",
                    "flags": ["nullable"]
                }
            ]
        },
        {
            "name": "res_int64",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "l",
                    "flags": ["nullable"]
                }
            ]
        },
        {
            "name": "res_int64_null",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "l",
                    "flags": ["nullable"]
                }
            ]
        },
        {
            "name": "res_string",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "u",
                    "flags": ["nullable"]
                }
            ]
        },
        {
            "name": "res_string_null",
            "format": "+l",
            "flags": ["nullable"],
            "children": [
                {
                    "name": "item",
                    "format": "u",
                    "flags": ["nullable"]
                }
            ]
        }
    ]
}

// part: expected

{"res_bool": [true, false], "res_bool_null": [], "res_int64": [1, 2, 3], "res_int64_null": [], "res_string": ["", "foobar"], "res_string_null": []}
