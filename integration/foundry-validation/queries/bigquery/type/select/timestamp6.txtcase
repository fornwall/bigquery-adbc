// part: metadata

[setup]
drop = "test_datetime"

[tags]
sql-type-name = "DATETIME"
field-type-name = "DATETIME"

// part: setup_query

CREATE TABLE test_datetime (
    idx INT64,
    res DATETIME
);

INSERT INTO test_datetime (idx, res) VALUES
    (1, DATETIME '2023-05-15 13:45:30'),
    (2, DATETIME '2000-01-01 00:00:00'),
    (3, DATETIME '1969-07-20 20:17:40'),
    (4, DATETIME '9999-12-31 23:59:59'),
    (5, NULL),
    (6, DATETIME '0001-01-01 00:00:00.000000'),
    (7, DATETIME '2023-05-15 13:45:30.123456');

// part: query

SELECT res FROM test_datetime ORDER BY idx

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tsu:",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": 1684158330000000}
{"res": 946684800000000}
{"res": -14182940000000}
{"res": 253402300799000000}
{"res": null}
{"res": -62135596800000000}
{"res": 1684158330123456}
